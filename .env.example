# Copy to .env at the repository root. Never commit real credentials.
# Local development only: scripts/dev.py db-start creates this database.
DATABASE_URL=postgresql+psycopg://iou@127.0.0.1:54329/iou
# Hosted Supabase project origin, matching frontend/.env.local. No Google secret needed.
# Leave blank for foundation-only local checks; /me then fails closed.
SUPABASE_URL=
# session: direct/session pooler; transaction: serverless transaction pooler (no prepared statements).
DATABASE_POOL_MODE=session
# For hosted DB, replace DATABASE_URL with the Connect dialog's pooler URL,
# using postgresql+psycopg:// and ?sslmode=require. Keep credentials server-only.
# Level 2 optional server-only configuration. NEVER put these keys in VITE_* variables.
# Generate a stable random cursor secret privately (at least 32 bytes); blank disables cursors.
# CURSOR_SIGNING_KEY=
# Supabase secret API key or legacy service_role key, NOT a Google secret/publishable key.
# SUPABASE_STORAGE_KEY=
EVIDENCE_BUCKET=iou-evidence
EVIDENCE_SIGNED_URL_SECONDS=60
# See docs/HISTORY_PROOF.md for private bucket setup and required cleanup operations.
# Level 5.0: credentials alone never enable real mail. Keep disabled until accepted.
# Templates only; no Gemini key required. See docs/REMINDERS.md.
EMAIL_MODE=disabled
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
# Generate privately with secrets.token_urlsafe(32); stable across API workers/restarts.
REMINDER_SIGNING_KEY=
# Backend API base, including /api if your deployment mounts it there.
# Loopback links work only on your own computer; other recipients require a public base.
REMINDER_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Self-addressed sending only by default. Additional consenting test recipients: JSON array.
GMAIL_RECIPIENT_ALLOWLIST=[]
GMAIL_ALLOW_EXTERNAL_RECIPIENTS=false
REMINDER_QUIET_HOURS_ENABLED=true
